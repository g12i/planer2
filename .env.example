# USOS API (https://usosapps.us.edu.pl/developers/)
USOS_CONSUMER_KEY=
USOS_CONSUMER_SECRET=
USOS_BASE_URL=https://usosapps.us.edu.pl

# Dev bypass: your student number (see server log on first login attempt)
ALLOWED_STUDENT_NUMBER=

# App origin (callback URL = {ORIGIN}/auth/usos/callback)
ORIGIN=http://localhost:5173

# Upstash Redis (sessions + OAuth pending tokens)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# 32-byte key, base64-encoded: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Supabase (server-only; Dashboard → Settings → API)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: manual POST /api/sync-programmes (Authorization: Bearer …)
SYNC_SECRET=